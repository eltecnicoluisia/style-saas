# Puerto de servicio
PORT=4000
NODE_ENV=production

# Clave secreta criptográfica de alta entropía para firma de tokens JWT (Mínimo 32 caracteres)
JWT_SECRET=reemplazar_con_clave_secreta_de_alta_entropia_produccion_2026

# Credenciales de base de datos PostgreSQL
POSTGRES_USER=style_user
POSTGRES_PASSWORD=reemplazar_con_password_seguro_postgres_2026
POSTGRES_DB=style_saas_db

# Cadena de conexión para Prisma ORM
DATABASE_URL=postgresql://style_user:reemplazar_con_password_seguro_postgres_2026@postgres:5432/style_saas_db?schema=public

# Control de orígenes CORS (opcional en producción, ej. https://miapp.com)
CORS_ORIGIN=*
